# Mount every live casket (registry) + static extras at boot, replacing the
# old one-fstab-line-per-casket scheme. Install (system unit, needs root):
#   sudo cp systemd/casket-mounts.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable casket-mounts.service
[Unit]
Description=Mount casket squashfs sources under /srv
RequiresMountsFor=/mnt/hdd
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# This path is a placeholder. Do not edit it by hand — run
# `sudo ./scripts/install-mounts-service.sh`, which rewrites ExecStart with
# THIS checkout's absolute path (a system unit cannot use %h).
ExecStart=/path/to/ocp-source-collector/scripts/casket-mounts.sh --apply

[Install]
WantedBy=multi-user.target

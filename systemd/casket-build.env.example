# Host-local settings every casket build needs. Copy to
# ~/.config/casket/build.env and adjust the paths for this host.
#
# Read by BOTH entry points, so a hand-run build matches the unattended one:
#   - casket-auto-update.service  (EnvironmentFile=%h/.config/casket/build.env)
#   - scripts/casket-build.sh     (lib.sh load_build_env; values already
#                                  exported in the environment win)
# casket-build.sh --apply refuses to run while either store is unset: the
# fallback puts it inside the repo on the root fs, and on 2026-09-26 a hand run
# wrote 181G there and re-downloaded everything the shared store already held.
#
# systemd EnvironmentFile syntax: KEY=VALUE, no `export`, no shell expansion.

# Dependency-source archive store (collect-deps.py). Regenerable, 150G+.
CASKET_DEP_STORE=/mnt/hdd/casket-dep-store

# Submodule archive store (collect-submodules.py). Keep it on the SAME
# filesystem as the stage, or the store->stage hardlinks become full copies.
CASKET_SUBMODULE_STORE=/home/USER/ocp-source-collector/submodule-store

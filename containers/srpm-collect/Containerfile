# Image for collecting SRPMs from RHEL repos via `dnf download --source`.
#
# Replaces the RHEL 9 VM that ran 01-extract-rpmdb.sh / 02-fetch-srpms.sh /
# 03-fetch-eus.sh. The container needs:
#   - oc CLI (for `oc adm release info --rpmdb`)
#   - dnf + subscription-manager (for `dnf download --source`)
#   - entitlement: the container registers itself (see collect.sh)
#
# ONE IMAGE PER RHEL MAJOR. subscription-manager generates redhat.repo only
# for the content sets the installed product certificate is tagged for: UBI9's
# /etc/pki/product-default/479.pem yields rhel-9-* and rhocp-*-for-rhel-9-*
# repos and nothing for RHEL 10, and UBI10's yields the rhel-10-* set
# (verified 2026-11-09: 101 rhel-10 source repos incl. rhocp-5.0-for-rhel-10).
# RHCOS 10 (OCP 4.21+ opt-in, the 5.0 default for fresh installs) therefore
# needs its own image, built from the same file:
#
#   podman build -f containers/srpm-collect/Containerfile \
#     -t casket-srpm-collect:el9 containers/srpm-collect
#   podman build -f containers/srpm-collect/Containerfile \
#     --build-arg BASE=registry.access.redhat.com/ubi10/ubi:latest \
#     -t casket-srpm-collect:el10 containers/srpm-collect
#
# scripts/phase-a-rpm-collect.sh builds whichever is missing and runs
# collect.sh -M <major> in the matching one.
ARG BASE=registry.access.redhat.com/ubi9/ubi:latest
FROM ${BASE}

RUN dnf install -y --setopt=install_weak_deps=False \
        dnf-plugins-core \
        jq \
        subscription-manager \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# oc CLI — detect arch and download the matching binary.
#
# OC_VERSION MUST be recent enough to carry `oc adm release info --rpmdb`.
# 4.17 does NOT ("error: unknown flag: --rpmdb"), and because collect.sh sent
# that call to /dev/null it surfaced as nine separate "rpmdb extraction
# failed" warnings rather than one missing flag. The host's own oc is 4.22.x
# and has it. Do not pin below the newest minor in
# config/phase-a-rpm-minors.txt: --rpmdb reads the machine-os image of every
# release queried, and the newest payload is the one most likely to need a
# matching client. Exception: 5.0 has no stable-5.0/ on the mirror (404 as of
# 2026-11-09), and a 4.22.8 client reads 5.0.1's rhel-coreos-10 rpmdb fine
# (489 packages), so 4.22 stays until the mirror publishes a 5.x client.
ARG OC_VERSION=4.22
RUN OC_ARCH=$(uname -m) \
    && case "$OC_ARCH" in x86_64) OC_SUFFIX="linux" ;; aarch64) OC_SUFFIX="linux-arm64" ;; *) echo "unsupported arch: $OC_ARCH" >&2; exit 1 ;; esac \
    && curl -sL "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable-${OC_VERSION}/openshift-client-${OC_SUFFIX}.tar.gz" \
       | tar -xzf - -C /usr/local/bin oc kubectl \
    && chmod +x /usr/local/bin/oc /usr/local/bin/kubectl

WORKDIR /work
COPY collect.sh cdn-fetch.py route-rows.awk /work/
RUN chmod +x /work/collect.sh /work/cdn-fetch.py
